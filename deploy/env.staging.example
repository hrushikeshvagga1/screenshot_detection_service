# Copy to .env.staging on the Droplet

MONGODB_URI=mongodb+srv://USER:PASSWORD@host.mongodb.net/staging_db?retryWrites=true&w=majority

SPACES_BUCKET=property-media-temp/phone-capture
SPACES_ENDPOINT=https://property-media-temp.sgp1.digitaloceanspaces.com
SPACES_ACCESS_KEY=DO00XXXXXXXXXXXX
SPACES_SECRET_KEY=your-secret-key

MONGO_BATCHES_COLLECTION=device_screenshot_batches
MONGO_RESULTS_COLLECTION=screenshot_analysis_results

# Queue (required for worker)
QUEUE_BACKEND=redis
REDIS_URL=rediss://default:PASSWORD@your-redis-host:25061
REDIS_QUEUE_KEY=screenshot:batch:jobs
QUEUE_RECEIVE_WAIT_SECONDS=20

POLL_INTERVAL_SEC=3
STALE_PROCESSING_MINUTES=15
MAX_BATCH_ATTEMPTS=5
PHONE_REGION=IN

# Optional: WORKER_ID=staging-worker-1
